# Paste this into the "Secrets" box on Streamlit Community Cloud (Settings -> Secrets),
# or copy it to .streamlit/secrets.toml to test the gate locally. Never commit secrets.toml.

# Visitors must enter this before they see anything.
APP_PASSWORD = "choose-a-long-password"

ANTHROPIC_API_KEY = "sk-ant-..."
LLM_PROVIDER = "anthropic"
LLM_MODEL = "claude-sonnet-5-5"

# Optional: live runs allowed per day (UTC) on the deployed app. Default 10.
# MAX_RUNS_PER_DAY = 10
